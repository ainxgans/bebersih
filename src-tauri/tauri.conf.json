{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "bebersih",
  "version": "0.1.0",
  "identifier": "com.bebersih.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bebersih - Ubuntu Cleaner",
        "width": 960,
        "height": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU3Q0VDQjg1NkQ3M0RENUIKUldSYjNYTnRoY3ZPNTJYQnBYeGNya29zaExCRFdHOGJCb0hnOHNnRHlxaUhoVjdlY0JZOHB0K1oK",
      "endpoints": [
        "https://github.com/ainxgans/bebersih/releases/latest/download/latest.json"
      ]
    }
  }
}
